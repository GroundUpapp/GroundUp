# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase (server-side). The secret key is SECRET — never expose to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key

# QuickBooks Online OAuth 2.0
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://project-06pgg.vercel.app/api/auth/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=production

# Where the OAuth flow redirects the browser back to (app origin).
# Leave blank for same-origin relative redirects (e.g. on Vercel).
APP_BASE_URL=

# Stripe subscription billing. Secrets — server-side only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Plan price IDs: Solo $49/mo, Pro $99/mo. (STRIPE_PRICE_ID kept as a fallback for Solo.)
STRIPE_PRICE_ID_SOLO=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID=

# Anthropic (AI assistant + report insights)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Resend (outbound email: weekly report + cash alerts)
RESEND_API_KEY=
# Verified sender; defaults to Resend's test sender if unset.
RESEND_FROM=Ground Up <onboarding@resend.dev>

# Secret shared with Vercel Cron to authorize /api/cron/* endpoints.
CRON_SECRET=

# Upstash Redis for per-user rate limiting (/assistant, /remind).
# If unset, rate limiting is skipped (the app still works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
